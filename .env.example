# Copie este arquivo para .env e ajuste os valores. Nunca envie o .env ao repositório.
DJANGO_DEBUG=True
DJANGO_SECRET_KEY=troque-por-uma-chave-aleatoria
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Banco de dados: "postgresql" (padrão do projeto) ou "sqlite" (atalho para começar sem PostgreSQL)
DB_ENGINE=postgresql
DB_NAME=esportivo
DB_USER=postgres
DB_PASSWORD=senha
DB_HOST=localhost
DB_PORT=5432

# Opcionais. No Render, nada disto precisa ser digitado: o render.yaml liga a DATABASE_URL ao
# banco e o endereço do site entra sozinho em ALLOWED_HOSTS e CSRF_TRUSTED_ORIGINS.
# DATABASE_URL=postgresql://usuario:senha@host:5432/banco   (se definida, vale no lugar de DB_*)
# DJANGO_CSRF_TRUSTED_ORIGINS=https://meu-dominio.exemplo
# DEMO_SENHA=                                                (senha dos usuários de demonstração)
